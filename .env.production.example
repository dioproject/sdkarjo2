# =============================================================================
# Production environment file
# COPY ke .env di server: cp .env.production.example .env
# JANGAN commit file .env yang sudah terisi.
# =============================================================================

# ---- PostgreSQL ----
# Buat password kuat: openssl rand -base64 32
POSTGRES_USER=sdkarjo
POSTGRES_PASSWORD=ganti-dengan-password-kuat-acak
POSTGRES_DB=sd_karjo_db

# ---- App / Auth ----
# Buat secret kuat: openssl rand -base64 64
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ---- Cloudflare Tunnel ----
# OPSI A — Quick Tunnel (FREE, tanpa domain): KOSONGKAN variabel ini.
#         URL akan otomatis muncul di log cloudflared, format: https://xxx.trycloudflare.com
#         URL ganti tiap kali tunnel restart.
#
# OPSI B — Named Tunnel (butuh domain di Cloudflare): isi token dari
#         https://one.dash.cloudflare.com  → Networks → Tunnels → Create a tunnel
CLOUDFLARE_TUNNEL_TOKEN=
